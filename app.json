{
  "expo": {
    "name": "EmotiSketch",
    "slug": "emotisketch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "emotisketch",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "EmotiSketch needs camera access to photograph your drawing.",
          "photosPermission": "EmotiSketch needs photo library access to upload drawings."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "679a56a0-13a7-464a-acc9-4b75480ec316"
      }
    },
    "owner": "azhaddar",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/679a56a0-13a7-464a-acc9-4b75480ec316"
    }
  }
}
